<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.smarthome">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.SmartHome">
        <activity
            android:name=".SmokeActivity"
            android:exported="false" />
        <activity
            android:name=".GasActivity"
            android:exported="false" />
        <activity
            android:name=".TemperatureActivity"
            android:exported="false" />
        <activity
            android:name=".DoorActivity"
            android:exported="false" />
        <activity
            android:name=".FanActivity"
            android:exported="false" />
        <activity
            android:name=".LightActivity"
            android:exported="false" /> <!-- Login Screen (App starts here) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- Main Smart Home Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
    </application>

</manifest>