<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🔥 TOOLBAR (IMPORTANT) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#3F51B5"
        android:title="Smart Home"
        android:titleTextColor="@android:color/white"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <!-- MAIN CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:background="#F4F6FA"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 🔥 Temperature Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:elevation="6dp"
                android:radius="16dp">

                <TextView
                    android:id="@+id/txtTemp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Temperature: 25°C"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:padding="20dp"
                    android:textColor="#333333"/>
            </androidx.cardview.widget.CardView>

            <!-- ⚠ Gas Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:elevation="5dp"
                android:radius="16dp">

                <TextView
                    android:id="@+id/txtGas"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="GAS : SAFE"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_safe"/>
            </androidx.cardview.widget.CardView>

            <!-- 🚨 Smoke Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:elevation="5dp"
                android:radius="16dp">

                <TextView
                    android:id="@+id/txtSmoke"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="SMOKE : SAFE"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_safe"/>
            </androidx.cardview.widget.CardView>

            <!-- 💡 Light Button -->
            <Button
                android:id="@+id/btnLight"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Light"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@android:color/darker_gray"
                android:layout_marginBottom="12dp"/>

            <!-- 🌀 Fan Button -->
            <Button
                android:id="@+id/btnFan"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Fan"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@android:color/darker_gray"
                android:layout_marginBottom="12dp"/>

            <!-- 🚪 Door Button -->
            <Button
                android:id="@+id/btnDoor"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Door"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@android:color/darker_gray"/>

        </LinearLayout>
    </ScrollView>

    <!-- NAVIGATION MENU -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/white"
        app:menu="@menu/drawer_menu"/>

</androidx.drawerlayout.widget.DrawerLayout>
